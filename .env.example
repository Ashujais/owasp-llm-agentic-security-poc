# OWASP AI Security Benchmark Environment Variables
# Copy to .env and insert API keys if live testing is desired.
# If omitted or left blank, high-fidelity offline deterministic simulation is automatically utilized.

# Anthropic API Key (for Claude 3.5 Sonnet live testing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google GenAI API Key (for Gemini 2.5 Flash live testing)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# App Configuration
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-20241022
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO
